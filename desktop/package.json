{
  "name": "unimaxdl-desktop",
  "version": "1.0.0",
  "description": "UnimaxDL — Free Universal Media Downloader Desktop Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win",
    "pack:mac": "electron-builder --mac",
    "pack:linux": "electron-builder --linux"
  },
  "keywords": [
    "video-downloader",
    "youtube",
    "tiktok",
    "instagram",
    "4k-downloader"
  ],
  "author": "Atomic Dhruba",
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.unimaxdl.desktop",
    "productName": "UnimaxDL",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "../assets/images/favicon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "../assets/images/icon2-512.png",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "../assets/images/icon2-512.png",
      "category": "Video"
    }
  }
}
